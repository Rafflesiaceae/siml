load("@rules_zig//zig:defs.bzl", "zig_static_library")

exports_files(
    ["siml.h"],
    visibility = ["//visibility:public"],
)

zig_static_library(
    name = "parser",
    main = "parser.zig",
    copts = ["-std=c89"],
    csrcs = ["siml.c"],
    deps = ["@rules_zig//zig/lib:libc"],
    extra_srcs = ["siml.h"],
    visibility = ["//visibility:public"],
)

platform(
    name = "linux-aarch64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "windows-x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)
